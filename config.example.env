# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# MediaWiki bot credentials (create a bot account on the wiki)
MEMEX_BOT_NAME=YourBotName
MEMEX_BOT_PASS=your-bot-password

# HTTP Basic Auth (if the wiki is behind HTTP authentication)
MEMEX_HTTP_USER=your-http-user
MEMEX_HTTP_PASS=your-http-password

# Wiki API endpoint
MEMEX_API_URL=https://scribb.com/memex/api.php

# Absolute path to the local Kuzu database directory
MEMEX_DB_PATH=/absolute/path/to/kuzu_db

# Local source directories for papers and books (used by local source index)
MEMEX_LOCAL_ARTICLES=~/Articles
MEMEX_LOCAL_ZOTERO=~/Zotero/storage
MEMEX_LOCAL_BOOKS=~/books
